# URL base do backend, sem barra no final. Copie para .env.local (dev) ou .env.production (build).
# É embutida no JavaScript no `next build`: mudar depois exige um novo build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Chat com IA (padrão: ligado). false tira o item do menu e a página /chat; também exige um novo build.
NEXT_PUBLIC_CHAT_ENABLED=true
